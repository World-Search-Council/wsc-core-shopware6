<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/shopware/platform/master/src/Core/System/SystemConfig/Schema/config.xsd">

    <card>
        <title>General Tracking Configuration</title>
        <title lang="de-DE">Allgemeine Tracking-Einstellungen</title>

        <input-field type="bool">
            <name>trackingActive</name>
            <label>Enable WSC Analytics Tracking</label>
            <label lang="de-DE">WSC Analytics Tracking aktivieren</label>
            <defaultValue>true</defaultValue>
        </input-field>

        <input-field type="single-select">
            <name>trackingMode</name>
            <label>Tracking Mode</label>
            <label lang="de-DE">Tracking-Modus</label>
            <defaultValue>cookieless</defaultValue>
            <options>
                <option>
                    <id>cookieless</id>
                    <name>Cookieless Privacy-First (100% GDPR compliant without cookie banner)</name>
                    <name lang="de-DE">Cookieless Privacy-First (100% DSGVO-konform ohne Cookie-Banner)</name>
                </option>
                <option>
                    <id>consent</id>
                    <name>Consent-Required (Integrated with Shopware Cookie Manager)</name>
                    <name lang="de-DE">Einwilligung erforderlich (Integriert mit Shopware Cookie Manager)</name>
                </option>
            </options>
        </input-field>

        <input-field type="bool">
            <name>excludeAdmins</name>
            <label>Exclude Admin Users from Tracking</label>
            <label lang="de-DE">Administratoren vom Tracking ausschließen</label>
            <defaultValue>true</defaultValue>
        </input-field>
    </card>

    <card>
        <title>WSC Gateway &amp; Hybrid Encryption (Opt-In)</title>
        <title lang="de-DE">WSC Gateway &amp; Hybrid-Verschlüsselung (Opt-In)</title>

        <input-field type="bool">
            <name>hybridEnabled</name>
            <label>Enable Hybrid Sync to WSC Cloud Gateway (Opt-In)</label>
            <label lang="de-DE">Hybrid-Synchronisation zum WSC Cloud Gateway aktivieren (Opt-In)</label>
            <defaultValue>false</defaultValue>
            <helpText>Disabled by default for strict privacy compliance. Enable to pair with api.worldsearchcouncil.org.</helpText>
        </input-field>

        <input-field type="text">
            <name>gatewayUrl</name>
            <label>Gateway API URL</label>
            <defaultValue>https://api.worldsearchcouncil.org</defaultValue>
        </input-field>

        <input-field type="text">
            <name>projectId</name>
            <label>Project ID</label>
            <helpText>Assigned by WSC Gateway upon opt-in handshake (proj_...).</helpText>
        </input-field>

        <input-field type="password">
            <name>apiSecret</name>
            <label>Gateway HMAC API Secret</label>
            <helpText>Issued during /v1/register handshake for X-WSC-Sig signing.</helpText>
        </input-field>

        <input-field type="password">
            <name>localKey</name>
            <label>Local AES-256 Key (64-char Hex)</label>
            <helpText>Auto-generated 256-bit encryption key for micro-batch payloads and daily session hashing.</helpText>
        </input-field>
    </card>

    <card>
        <title>WSC Membership, Credentials &amp; Agency Co-Branding</title>
        <title lang="de-DE">WSC Mitgliedschaft, Zertifizierung &amp; Agentur Co-Branding</title>

        <input-field type="text">
            <name>licenseKey</name>
            <label>WSC Member / Partner Credential Key</label>
            <label lang="de-DE">WSC Mitglieds- / Partner-Lizenzschlüssel</label>
            <helpText>Optional credential from worldsearchcouncil.org/member/licenses. 100% of local features remain unlocked without a key.</helpText>
        </input-field>

        <input-field type="text">
            <name>licenseStatus</name>
            <label>Credential Status</label>
            <defaultValue>unregistered</defaultValue>
        </input-field>

        <input-field type="text">
            <name>licenseTier</name>
            <label>Membership Tier</label>
            <defaultValue>community</defaultValue>
        </input-field>

        <input-field type="text">
            <name>licenseHolder</name>
            <label>Verified Credential Holder</label>
        </input-field>

        <input-field type="int">
            <name>licenseExpires</name>
            <label>Credential Expiry (Unix Timestamp)</label>
            <defaultValue>0</defaultValue>
        </input-field>

        <input-field type="bool">
            <name>licenseIsDemo</name>
            <label>Demo Sandbox Credential</label>
            <defaultValue>false</defaultValue>
        </input-field>

        <input-field type="textarea">
            <name>coBranding</name>
            <label>Agency Co-Branding JSON</label>
            <helpText>JSON configuration for agency_name, logo_url, support_url, support_email, custom_footer.</helpText>
        </input-field>
    </card>

    <card>
        <title>AI Readiness (/llms.txt), Benchmarks &amp; Opt-In IndexNow</title>
        <title lang="de-DE">AI Readiness (/llms.txt), Benchmarks &amp; Opt-In IndexNow</title>

        <input-field type="bool">
            <name>llmsTxtEnabled</name>
            <label>Serve Public /llms.txt AI Manifest</label>
            <label lang="de-DE">Öffentliches /llms.txt KI-Manifest bereitstellen</label>
            <defaultValue>true</defaultValue>
        </input-field>

        <input-field type="single-select">
            <name>industryVertical</name>
            <label>Industry Benchmark Vertical</label>
            <label lang="de-DE">Branchen-Benchmark-Kategorie</label>
            <defaultValue>/Shopping/Apparel</defaultValue>
            <options>
                <option><id>/Shopping/Apparel</id><name>E-Commerce: Fashion, Apparel &amp; Footwear</name></option>
                <option><id>/Shopping/Consumer Electronics</id><name>E-Commerce: Consumer Electronics &amp; Tech</name></option>
                <option><id>/Home &amp; Garden</id><name>Furniture, Home &amp; Garden</name></option>
                <option><id>/Computers &amp; Electronics/Enterprise Software</id><name>IT, SaaS &amp; Enterprise Software</name></option>
                <option><id>/Health/Medical &amp; Wellness</id><name>Health, Medical &amp; Wellness</name></option>
                <option><id>/Business &amp; Industrial/Services</id><name>B2B, Consulting &amp; Professional Services</name></option>
                <option><id>/Food &amp; Drink/Restaurants &amp; Groceries</id><name>Food, Restaurants &amp; Groceries</name></option>
                <option><id>/News/Media &amp; Publishing</id><name>News, Media &amp; Digital Publishing</name></option>
                <option><id>/Finance/Banking &amp; Insurance</id><name>Finance, Banking &amp; Insurance</name></option>
                <option><id>/Travel/Tourism &amp; Hospitality</id><name>Travel, Tourism &amp; Hospitality</name></option>
            </options>
        </input-field>

        <input-field type="bool">
            <name>indexnowEnabled</name>
            <label>Enable Automatic IndexNow Push on Product Save (Opt-In)</label>
            <label lang="de-DE">Automatischen IndexNow-Push beim Speichern von Produkten aktivieren (Opt-In)</label>
            <defaultValue>false</defaultValue>
            <helpText>Strictly opt-in. Automatically pings api.indexnow.org when active products are updated.</helpText>
        </input-field>

        <input-field type="text">
            <name>indexnowKey</name>
            <label>IndexNow Verification Key (32-char Hex)</label>
            <helpText>Auto-generated key served dynamically at /{key}.txt.</helpText>
        </input-field>
    </card>

    <card>
        <title>AI &amp; Search Bot Shield Sensor</title>
        <title lang="de-DE">AI &amp; Search Bot Shield Sensor</title>

        <input-field type="single-select">
            <name>botTrackingLevel</name>
            <label>Bot Tracking Scope</label>
            <label lang="de-DE">Bot-Tracking Umfang</label>
            <defaultValue>search_ai</defaultValue>
            <options>
                <option><id>off</id><name>Disabled</name><name lang="de-DE">Deaktiviert</name></option>
                <option><id>ai_only</id><name>AI / LLM Bots only (GPTBot, Claude, Perplexity)</name><name lang="de-DE">Nur KI-Bots</name></option>
                <option><id>search_ai</id><name>Search Engines + AI Bots (Recommended)</name><name lang="de-DE">Suchmaschinen + KI-Bots (Empfohlen)</name></option>
                <option><id>all</id><name>All known crawlers &amp; SEO tools</name><name lang="de-DE">Alle Crawler &amp; SEO-Tools</name></option>
            </options>
        </input-field>
    </card>

    <card>
        <title>E-Commerce &amp; Automated Interactions</title>
        <title lang="de-DE">E-Commerce &amp; Automatische Interaktionen</title>

        <input-field type="bool">
            <name>trackServerOrders</name>
            <label>100% Ad-Blocker Immune Server-Side Order Tracking</label>
            <label lang="de-DE">100% Ad-Blocker-immunes Server-Side Bestell-Tracking</label>
            <defaultValue>true</defaultValue>
        </input-field>

        <input-field type="bool">
            <name>autoDownloads</name>
            <label>Auto-track file downloads</label>
            <defaultValue>false</defaultValue>
        </input-field>

        <input-field type="bool">
            <name>autoTimeOnPage</name>
            <label>Auto-track active engaged time on page</label>
            <defaultValue>false</defaultValue>
        </input-field>
    </card>

    <card>
        <title>Data Retention</title>
        <title lang="de-DE">Datenaufbewahrung</title>

        <input-field type="int">
            <name>retentionDays</name>
            <label>Local Queue Retention (Days)</label>
            <defaultValue>30</defaultValue>
        </input-field>
    </card>
</config>
